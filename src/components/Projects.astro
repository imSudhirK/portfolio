---
interface Project {
	name: string;
	description: string;
	impact: string;
	stack: string[];
}

const projects: Project[] = [
	{
		name: 'Loan Origination System (LOS)',
		description:
			'RM panel built with Node.js and Next.js — role-based workflows, server-driven rendering, and Redis-backed caching over PostgreSQL and MongoDB.',
		impact: 'Boosted RM efficiency by 30%',
		stack: ['Next.js', 'Node.js', 'Redis', 'PostgreSQL', 'MongoDB'],
	},
	{
		name: 'AI-Powered Underwriting Platform',
		description:
			'Real-time analytics on bureau data, balance sheets, and GSTR-3B filings, streamed through Kafka to drive automated credit decisions.',
		impact: 'Reduced underwriting time by 20–30%',
		stack: ['Kafka', 'Node.js', 'Python'],
	},
	{
		name: 'Document Processing Automation',
		description:
			'Microservice for OCR-driven agreement generation, document ingestion, and Excel-based financial report automation.',
		impact: 'Cut processing time 40%, saved 100+ hrs/month',
		stack: ['Node.js', 'OCR', 'AWS'],
	},
	{
		name: 'Client-Side Caching Service',
		description:
			'Caching and computation layer using Service Workers and IndexedDB to move heavy computation to the client.',
		impact: 'Reduced system latency by 80%',
		stack: ['Service Workers', 'IndexedDB', 'AWS'],
	},
];
---

<section id="projects" class="projects">
	<h2 class="section-heading"><span class="index">03.</span> Projects</h2>
	<div class="grid">
		{
			projects.map((project) => (
				<div class="card">
					<h3>{project.name}</h3>
					<p>{project.description}</p>
					<p class="impact">→ {project.impact}</p>
					<ul class="stack">
						{project.stack.map((tech) => <li>{tech}</li>)}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}

	.card {
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.5rem;
		background: var(--bg-card);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.card h3 {
		margin: 0 0 0.6rem;
		font-size: 1rem;
		color: var(--text);
	}

	.card p {
		margin: 0 0 0.5rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.impact {
		color: var(--accent) !important;
		font-family: var(--mono);
		font-size: 0.82rem !important;
	}

	.stack {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		margin: 0.75rem 0 0;
	}

	.stack li {
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.2rem 0.5rem;
	}
</style>
