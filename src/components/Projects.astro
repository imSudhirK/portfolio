---
interface Project {
	name: string;
	description: string;
	link?: string;
}

const projects: Project[] = [
	{
		name: 'Project One',
		description: 'Short description of what this project does and the problem it solves.',
		link: 'https://github.com/imSudhirK',
	},
	{
		name: 'Project Two',
		description: 'Short description of what this project does and the problem it solves.',
		link: 'https://github.com/imSudhirK',
	},
	{
		name: 'Project Three',
		description: 'Short description of what this project does and the problem it solves.',
		link: 'https://github.com/imSudhirK',
	},
];
---

<section id="projects" class="projects">
	<h2>Projects</h2>
	<p class="hint">Edit this list in src/components/Projects.astro with your real projects.</p>
	<div class="grid">
		{
			projects.map((project) => (
				<a class="card" href={project.link} target="_blank" rel="noopener noreferrer">
					<h3>{project.name}</h3>
					<p>{project.description}</p>
				</a>
			))
		}
	</div>
</section>

<style>
	.hint {
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
		margin-top: 1.5rem;
	}

	.card {
		display: block;
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.25rem;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease;
	}

	.card:hover {
		border-color: var(--accent);
	}

	.card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
	}

	.card p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
</style>
