---
const skills = [
	'Node.js',
	'React.js',
	'Next.js',
	'TypeScript',
	'JavaScript',
	'Python',
	'MongoDB',
	'PostgreSQL',
	'Redis',
	'SQL',
	'Kafka',
	'Docker',
	'AWS',
	'Git',
	'C++',
	'Bash',
];
---

<section id="skills" class="skills">
	<h2 class="section-heading"><span class="index">02.</span> Skills</h2>
	<pre class="code-block"><code><span class="kw">const</span> <span class="var">skills</span> = [
{skills.map((skill) => `  "${skill}",\n`).join('')}];</code></pre>
</section>

<style>
	.code-block {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.5rem 1.75rem;
		overflow-x: auto;
		font-family: var(--mono);
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0;
	}

	.kw {
		color: #c792ea;
	}

	.var {
		color: #82aaff;
	}

	code {
		color: #c3e88d;
		white-space: pre;
	}
</style>
