---
const paragraphs = [
	`I'm a Software Developer with 3+ years of experience building scalable full-stack systems in fintech and SaaS at Credflow, working across microservices, AI-driven platforms, and high-throughput customer-facing products.`,
	`My core stack is Node.js, React, Next.js, TypeScript, MongoDB, PostgreSQL, and Redis, with hands-on experience in Kafka, Docker, and AWS for building event-driven and distributed systems.`,
	`I hold a B.Tech in Computer Science & Engineering from IIT Bombay. I enjoy backend engineering, system design, and turning messy real-world financial workflows into simple, reliable software.`,
];
---

<section id="about" class="about">
	<div class="inner">
		<h2 class="section-heading"><span class="index">01.</span> About</h2>
		{paragraphs.map((p) => <p>{p}</p>)}
	</div>
</section>

<style>
	.about {
		background: var(--bg-alt);
		max-width: none;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.inner {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	p {
		color: var(--text-muted);
		max-width: 68ch;
	}
</style>
