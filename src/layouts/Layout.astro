---
import Nav from '../components/Nav.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Sudhir Kumar — Software Developer',
	description = 'Portfolio of Sudhir Kumar, a full-stack software developer (Node.js, React, Next.js) building fintech and SaaS platforms.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconSvg = `${base}/favicon.svg`;
const faviconIco = `${base}/favicon.ico`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconSvg} />
		<link rel="icon" href={faviconIco} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0e14" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="bg-grid"></div>
		<Nav />
		<slot />
		<footer>
			<p>
				<span class="prompt">$</span> built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
				· hosted on GitHub Pages ·
				<a href="https://github.com/imSudhirK/portfolio" target="_blank" rel="noopener noreferrer">view source</a>
			</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a0e14;
		--bg-alt: #0d1420;
		--bg-card: #10192b;
		--text: #ccd6f6;
		--text-muted: #8892b0;
		--accent: #64ffda;
		--accent-dim: rgba(100, 255, 218, 0.12);
		--border: #1f2b45;
		--max-width: 900px;
		--mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		--sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		line-height: 1.65;
		position: relative;
	}

	.bg-grid {
		position: fixed;
		inset: 0;
		z-index: -1;
		background-image: linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 48px 48px;
		opacity: 0.25;
		mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 100%);
	}

	section {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 5rem 1.5rem;
	}

	h1,
	h2,
	h3 {
		line-height: 1.25;
		font-family: var(--mono);
	}

	code,
	.mono {
		font-family: var(--mono);
	}

	a {
		color: var(--accent);
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0 0 2rem;
		font-family: var(--mono);
		font-size: 1.4rem;
		color: var(--text);
	}

	.section-heading .index {
		color: var(--accent);
		font-size: 1rem;
	}

	.section-heading::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border);
		margin-left: 0.5rem;
	}

	footer {
		border-top: 1px solid var(--border);
		text-align: center;
		padding: 2rem 1.5rem 3rem;
	}

	footer p {
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0;
	}

	footer .prompt {
		color: var(--accent);
	}

	footer a {
		color: var(--text-muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	footer a:hover {
		color: var(--accent);
	}

	::selection {
		background: var(--accent-dim);
		color: var(--text);
	}
</style>
